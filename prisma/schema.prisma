generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ROLES ──────────────────────────────────────────────
enum Role {
  SUPERADMIN
  ADMIN
  MEMBER
}

// ─── USER ───────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member   Member?
  gradesby FFCSGrade[]
}

// ─── MEMBER ─────────────────────────────────────────────
enum Category {
  CORE
  MEMBER
  DANCER
  FFCS_ONLY
}

enum FFCSGrade_Enum {
  S
  A
  B
  C
  D
  E
}

model Member {
  id             String    @id @default(cuid())
  fullName       String
  registerNumber String    @unique
  email          String    @unique
  phone          String?
  department     String
  academicYear   Int
  category       Category
  isFFCS         Boolean   @default(false)
 position       String?
  team           String?
  photoUrl       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  timetableEntries TimetableEntry[]
  ffcsGrades       FFCSGrade[]
  reports          Report[]         @relation("SubmittedReports")
  reviewedReports  Report[]         @relation("ReviewedReports")
  notifications    Notification[]
  odRequests       ODRequest[]
}

// ─── TIMETABLE ──────────────────────────────────────────
enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum SlotStatus {
  FREE
  CLASS
}

model TimetableEntry {
  id       String     @id @default(cuid())
  day      Day
  slot     String
  status   SlotStatus @default(FREE)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, day, slot])
}

// ─── SATURDAY PLANNER ───────────────────────────────────
model SaturdayPlanner {
  id         String   @id @default(cuid())
  weekStart  DateTime @unique
  followsDay Day
  createdAt  DateTime @default(now())
}

// ─── FFCS GRADES ────────────────────────────────────────
model FFCSGrade {
  id        String         @id @default(cuid())
  subject   String
  grade     FFCSGrade_Enum
  remarks   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  memberId   String
  member     Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  gradedById String
  gradedBy   User   @relation(fields: [gradedById], references: [id])
}

// ─── REPORTS ────────────────────────────────────────────
enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

model Report {
  id          String       @id @default(cuid())
  description String
  workDate    DateTime
  imageUrl    String
  imagePath   String
  status      ReportStatus @default(PENDING)
  reviewNotes String?
  submittedAt DateTime     @default(now())
  reviewedAt  DateTime?

  memberId String
  member   Member @relation("SubmittedReports", fields: [memberId], references: [id], onDelete: Cascade)

  reviewedById String?
  reviewedBy   Member? @relation("ReviewedReports", fields: [reviewedById], references: [id])

  notification Notification?
  odRequest    ODRequest?
}

// ─── NOTIFICATIONS ──────────────────────────────────────
enum NotificationType {
  REPORT_APPROVED
  REPORT_REJECTED
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  reportId String? @unique
  report   Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)
}

// ─── OD REQUESTS ────────────────────────────────────────
enum ODStatus {
  PENDING
  APPROVED
}

model ODRequest {
  id           String    @id @default(cuid())
  reason       String
  activityDate DateTime
  slots        String[]  @default([])
  status       ODStatus  @default(PENDING)
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  reportId String  @unique
  report   Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
}